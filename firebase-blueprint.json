{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered customer or service provider profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["customer", "provider", "admin"] },
        "city": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role"]
    },
    "Booking": {
      "title": "Service Booking",
      "description": "On-demand or scheduled service booking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "providerId": { "type": "string", "maxLength": 128 },
        "providerName": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "In Progress", "Completed", "Cancelled"] },
        "amount": { "type": "number" },
        "scheduledDate": { "type": "string", "maxLength": 50 },
        "city": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "providerId", "category", "status", "amount"]
    },
    "Provider": {
      "title": "Service Provider",
      "description": "Verified service technician profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "rating": { "type": "number" },
        "totalReviews": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "city": { "type": "string", "maxLength": 50 },
        "verified": { "type": "boolean" },
        "avatar": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 30 },
        "skills": { "type": "array" }
      },
      "required": ["name", "category", "rating", "hourlyRate"]
    },
    "Review": {
      "title": "Provider Review",
      "description": "Customer feedback and rating for a provider",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "bookingId": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "providerId": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "providerId", "rating"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile data"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Service request bookings"
    },
    "/providers/{providerId}": {
      "schema": { "$ref": "#/entities/Provider" },
      "description": "Service provider listings"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer feedback and ratings"
    }
  }
}
